# Deployer/owner private key used by scripts/deploy.js, scripts/upgrade.js,
# scripts/check-owner.js, and scripts/post-upgrade-init.js.
# NEVER commit your real .env file — this is an example only.
PRIVATE_KEY=

# Optional — address that receives shop USDC payments. Defaults to the
# deployer address if unset.
TREASURY_ADDRESS=

# Optional — only needed to verify the contract source on Basescan after
# deploying (npx hardhat verify).
BASESCAN_API_KEY=

# Optional — required by scripts/check-owner.js, scripts/upgrade.js, and
# scripts/post-upgrade-init.js to target an already-deployed proxy. Fill in
# after running scripts/deploy.js.
CONTRACT_ADDRESS=
