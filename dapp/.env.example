# Base RPC endpoint used by wagmi's transport (falls back to the public
# https://mainnet.base.org endpoint if unset, which is rate-limited — set a
# real Alchemy/Infura Base URL for production).
NEXT_PUBLIC_ALCHEMY_RPC_URL=

# Goldsky subgraph endpoint indexing the Focusling contract on Base.
# Used for the leaderboard, activity history, and username/pet-name
# uniqueness checks.
NEXT_PUBLIC_SUBGRAPH_URL=

# Optional — overrides the landing page's "Get Started" link target.
# Defaults to "/app". Only needed if the app is split across subdomains.
NEXT_PUBLIC_APP_URL=

# Server-only — private key for the dedicated gas-faucet wallet (see
# src/app/api/faucet/route.ts). Use a separate, lightly-funded wallet —
# never the contract owner/deployer key. Never commit the real value.
FAUCET_PRIVATE_KEY=

# Optional — Nimiq Albatross JSON-RPC endpoint, used only to display the
# user's NIM balance in the shop (src/hooks/useNimiqPay.ts). Falls back to
# the free, rate-limited community node https://rpc.nimiqwatch.com if unset
# (no uptime guarantee — set your own node for anything beyond casual use).
NEXT_PUBLIC_NIMIQ_RPC_URL=
